{
  "name": "daisy-vue",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "build-lib": "vue-tsc -b ./tsconfig.lib.json && vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "uuid": "^13.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
